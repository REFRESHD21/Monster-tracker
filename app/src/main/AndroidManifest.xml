<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intentionally no permissions: no network, accounts or broad file access. -->
    <application android:label="Monster Tracker" android:icon="@drawable/ic_monster"
        android:theme="@style/AppTheme" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <provider android:name=".ReceiptProvider" android:authorities="${applicationId}.receipts" android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".BusinessActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

